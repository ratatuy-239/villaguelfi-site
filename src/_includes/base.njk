{%- set t = texts[lang] -%}
{%- set otherLang = "it" if lang == "en" else "en" -%}
<!doctype html>
<html lang="{{ t.htmlLang }}" data-ga="{{ site.analyticsId }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle or t.title }}</title>
  <meta name="description" content="{{ pageDescription or t.description }}">
  {%- if build.preview or noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if alternates %}
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ alternates.en }}">
  <link rel="alternate" hreflang="it" href="{{ site.url }}{{ alternates.it }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alternates.en }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle or t.title }}">
  <meta property="og:description" content="{{ pageDescription or t.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/hero/01.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/oswald.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>

  <header class="header" data-header>
    <a class="header__logo" href="{{ t.home }}">{{ site.name }}</a>
    <button class="header__burger" type="button" aria-label="Menu" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
    <nav class="header__nav" data-nav>
      <a href="{{ t.home }}#about">{{ t.menu.about }}</a>
      <a href="{{ t.home }}#houses">{{ t.menu.houses }}</a>
      <a href="{{ t.home }}#features">{{ t.menu.features }}</a>
      <a href="{{ t.home }}#contact">{{ t.menu.contact }}</a>
      <span class="header__langs">
        <a href="{{ alternates.en if alternates else '/' }}" hreflang="en" {% if lang == "en" %}aria-current="true"{% endif %}>EN</a>
        <a href="{{ alternates.it if alternates else '/it/' }}" hreflang="it" {% if lang == "it" %}aria-current="true"{% endif %}>IT</a>
      </span>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="footer__left">
      <span>© {{ build.year }} {{ site.name }}</span>
      <a href="{{ '/privacy/' if lang == 'en' else '/it/privacy/' }}">{{ t.footer.privacy }}</a>
    </div>
    <div class="footer__social">
      <a href="mailto:{{ site.email }}" aria-label="E-mail">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </a>
      <a href="{{ site.telegram }}" target="_blank" rel="noopener" aria-label="Telegram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 4.3 3.6 10.8c-.8.3-.8 1 0 1.200l4.200 1.300 1.600 5c.2.600.9.700 1.300.300l2.300-2.200 4.300 3.200c.5.400 1.200.100 1.300-.5l2.900-13.700c.200-.8-.4-1.400-1-1.100zM9.700 13.800l7.300-5.300-5.800 6.300-.2 2.600z" fill="currentColor"/></svg>
      </a>
      <a href="{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.500a8.500 8.500 0 0 0-7.300 12.800L3.500 20.500l4.300-1.100A8.500 8.500 0 1 0 12 3.500zm4.900 12c-.2.600-1.200 1.100-1.700 1.200-.400.100-1 .100-1.600-.100-2.800-1-4.600-3.800-4.700-4-.100-.200-1.100-1.500-1.100-2.800s.7-2 .9-2.300c.200-.300.500-.300.700-.300h.500c.2 0 .400 0 .600.500l.8 2c.100.200.100.400 0 .500l-.6.800c-.1.200-.3.300-.1.600.800 1.300 1.700 2 2.900 2.500.300.100.400.100.600-.1l.8-1c.2-.2.400-.2.600-.1l1.900.9c.200.100.400.200.500.300 0 .200 0 .800-.2 1.400z" fill="currentColor"/></svg>
      </a>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.500" y="4.500" width="15" height="15" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.400" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="16.400" cy="7.600" r="1.100" fill="currentColor"/></svg>
      </a>
    </div>
  </footer>

  <div class="cookies" data-cookies hidden>
    <p>{{ t.cookies.text }} <a href="{{ '/privacy/' if lang == 'en' else '/it/privacy/' }}">{{ t.cookies.more }}</a></p>
    <div class="cookies__buttons">
      <button type="button" class="btn btn--ghost" data-cookies-decline>{{ t.cookies.decline }}</button>
      <button type="button" class="btn" data-cookies-accept>{{ t.cookies.accept }}</button>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="{{ t.photoOf }}">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="{{ t.close }}">×</button>
    <button type="button" class="arrow arrow--prev" data-lightbox-prev aria-label="{{ t.prev }}"></button>
    <img alt="" data-lightbox-img>
    <button type="button" class="arrow arrow--next" data-lightbox-next aria-label="{{ t.next }}"></button>
  </dialog>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
